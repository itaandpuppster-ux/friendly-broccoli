# ===========================================================================
#  Instagram 3D Art Pipeline — API KEY CONFIG
# ===========================================================================
#  1. Copy this file to ".env"        ->  cp .env.example .env
#  2. Paste your real keys below (no quotes needed).
#  3. Run the pipeline                 ->  python run_pipeline.py
#
#  Only the providers you actually use need a key:
#    - Step 1 & 2 (image + segmentation) use FAL_KEY by default.
#    - Step 3 (image -> 3D) uses EITHER Tripo3D OR Meshy (pick one).
# ===========================================================================

# --- Step 1: Image generation (Fal.ai / Flux)  [REQUIRED for default flow] --
FAL_KEY=

# --- Step 1 (alternative): Midjourney via a proxy provider  [OPTIONAL] ------
# Midjourney has no official API. If you use a hosted proxy (e.g. useapi.net,
# goapi.ai, imagineapi.dev) put its key + base URL here and set
# IMAGE_PROVIDER=midjourney in config.py.
MIDJOURNEY_API_KEY=
MIDJOURNEY_BASE_URL=

# --- Step 3: Image -> 3D. Choose ONE provider (set MODEL_3D_PROVIDER) --------
TRIPO_API_KEY=
MESHY_API_KEY=
